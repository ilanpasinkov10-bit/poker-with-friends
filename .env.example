# ---------------------------------------------------------------------------
# Poker With Friends — environment variables
#
# Copy to .env.local and fill in from your Supabase project:
#   Dashboard → Project Settings → API Keys
# NEVER commit .env.local, and never paste these values into a chat or an issue.
# ---------------------------------------------------------------------------

# Project URL. Public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser key. Public by design — it is safe to ship to the client, and every
# request it makes is still constrained by Row Level Security.
# New projects call this the "publishable key" (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
# Older projects call the same thing the "anon" key (a JWT). Either name works;
# set only one.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL, used for share links (/join/A7K92) and auth redirects.
# On Vercel this may be left unset — VERCEL_URL is used as a fallback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SERVER-ONLY. Bypasses Row Level Security entirely.
# Must never be prefixed with NEXT_PUBLIC_ and must never reach the browser.
# Optional: the app runs without it. It is only used for privileged maintenance
# that has no user identity.
# ---------------------------------------------------------------------------
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx
# Legacy name for the same thing:
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# WEB PUSH (optional).
#
# Leave all of these unset and the app behaves exactly as before: the settings
# toggle still saves, the browser is never asked for notification permission,
# and nothing is sent. Set them to turn push on.
#
# Generate a key pair once, and keep the private half secret:
#   npm run push:keys
# ---------------------------------------------------------------------------

# Identifies this sender to the push service. Public by design — the browser
# needs it in order to subscribe at all.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# The signing half. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# VAPID_PRIVATE_KEY=

# A contact address the push service can use if something is wrong with the
# messages this app sends. Must be a mailto: or https: URL.
# VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# SCHEDULED REMINDERS (optional).
#
# Shared secret for /api/cron/ending-soon, which sends the "one hour to go"
# notification. Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`.
# Without it the route refuses every request, so the reminder is off.
# ---------------------------------------------------------------------------
# CRON_SECRET=
