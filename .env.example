# ---------------------------------------------------------------------------
# Poker With Friends — environment variables
# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase Dashboard → Project Settings → API). NEVER commit .env.local.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public base URL of the deployment. Used to build share links (/join/A7K92)
# and auth redirect URLs. On Vercel this can stay unset — VERCEL_URL is used.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — MUST NOT be prefixed with NEXT_PUBLIC_ and must never reach
# the browser. Used only for privileged maintenance operations on the server.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
